<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Contact Center — Solution &amp; Live Simulation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --deep:#1B5E20;--deep-dk:#0D3B13;--lime:#7CB342;--lime-soft:#E8F5E9;
  --soft2:#F1F8E9;--bg:#FFFFFF;--card:#FFFFFF;--card-border:#D7E1D4;
  --tile:#F8FAF7;--ink:#1A1A1A;--mute:#5F6F62;--rule:#E5EBE3;
  --amber:#F59E0B;--blue:#2563EB;--wa:#25D366;--danger:#EF4444;--shadow:0 2px 10px rgba(0,0,0,.06);
}
html,body{height:100%;overflow:hidden}
body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--ink);display:flex;flex-direction:column}

/* --- Top Header with Direct Logo Assets --- */
.top{background:var(--deep);padding:10px 28px;display:flex;align-items:center;gap:18px;flex-shrink:0}
.brand-img-wrap{display:flex;align-items:center;gap:8px}
.top .div{width:1px;height:30px;background:rgba(255,255,255,.25)}
.top h1{font-size:15px;font-weight:700;margin:0;line-height:1.2;color:#fff}
.top .sub{font-size:11px;color:#C6E2CB}
.top .client-block{margin-left:auto;display:flex;align-items:center;gap:14px;text-align:right}
.top .client-logo-box{display:flex;align-items:center;background:transparent;padding:0;border:none}
.top .client-text{display:flex;flex-direction:column;justify-content:center}
.top .client-name{font-size:13.5px;font-weight:800;color:#fff;letter-spacing:.3px}
.top .client-date{font-size:11px;color:#C6E2CB;font-family:'IBM Plex Mono',monospace}

/* ... existing code ... ... existing styles ... */

.admin-badge{font-size:11.5px;font-weight:800;color:var(--deep);background:var(--lime-soft);border:1px solid rgba(124,179,66,.4);padding:4px 10px;border-radius:6px;letter-spacing:.3px}
.traffic-switcher{display:inline-flex;gap:3px;background:#E8ECE6;border-radius:7px;padding:2px;margin-left:8px}
.ts-btn{border:none;background:transparent;padding:4px 10px;border-radius:5px;font:inherit;font-size:11px;font-weight:600;color:var(--mute);cursor:pointer;transition:all .2s}
.ts-btn.active{background:#fff;color:var(--deep);font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.1)}

/* Breakdown Cards (Matching image_224762.png & image_2243c3.png) */
.analytics-breakdown-grid{display:grid;grid-template-columns:1fr 1.35fr 1fr;gap:16px;margin-top:2px}
@media (max-width:1120px){.analytics-breakdown-grid{grid-template-columns:1fr}}

.contact-reasons-list{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.reason-item{display:flex;flex-direction:column;gap:3px;padding:6px 8px;border-radius:6px;transition:background .2s}
.reason-item.highlighted{background:#EDE9FE}
.reason-row-top{display:flex;justify-content:space-between;font-size:11.5px}
.reason-row-top span{color:var(--ink);font-weight:600}
.reason-row-top strong{font-family:'IBM Plex Mono',monospace;color:var(--ink)}
.reason-track{height:6px;background:#E2E8F0;border-radius:3px;overflow:hidden}
.reason-fill-bar{height:100%;background:#4F46E5;border-radius:3px}

.topic-sentiment-list{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.ts-row{display:flex;flex-direction:column;gap:4px}
.ts-label-row{display:flex;justify-content:space-between;font-size:11.5px}
.ts-label-row span{color:var(--ink);font-weight:600}
.ts-label-row .ts-ratio{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--mute)}
.ts-bar-stacked{height:8px;background:#E2E8F0;border-radius:4px;overflow:hidden;display:flex}
.ts-pos{background:#15803D;height:100%}
.ts-neu{background:#0E7490;height:100%}
.ts-neg{background:#DC2626;height:100%}

.handoff-list{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.handoff-item{display:flex;flex-direction:column;gap:4px}
.handoff-top{display:flex;justify-content:space-between;font-size:11.5px}
.handoff-top span{color:var(--ink)}
.handoff-top strong{font-family:'IBM Plex Mono',monospace;color:var(--ink)}
.handoff-track{height:6px;background:#E2E8F0;border-radius:3px;overflow:hidden}
.handoff-fill{height:100%;background:#4F46E5;border-radius:3px}

.top .div{width:1px;height:30px;background:rgba(255,255,255,.25)}
.top h1{font-size:15px;font-weight:700;margin:0;line-height:1.2;color:#fff}
.top .sub{font-size:11px;color:#C6E2CB}
.top .client-block{margin-left:auto;display:flex;align-items:center;gap:14px;text-align:right}
.top .client-logo-box{display:flex;align-items:center}
.top .client-logo-box img{height:32px;width:auto;display:block;mix-blend-mode:screen;object-fit:contain}
.top .client-text{display:flex;flex-direction:column;justify-content:center}
.top .client-name{font-size:13.5px;font-weight:800;color:#fff;letter-spacing:.3px}
.top .client-date{font-size:11px;color:#C6E2CB;font-family:'IBM Plex Mono',monospace}

/* --- Navigation Tab Bar --- */
.tab-bar{background:#F8FAF7;border-bottom:1px solid #D7E1D4;display:flex;align-items:center;padding:0 28px;gap:8px;flex-shrink:0}
.tab-btn{background:transparent;border:none;border-bottom:3px solid transparent;color:var(--mute);font:inherit;font-size:13px;font-weight:600;padding:12px 18px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:all .2s}
.tab-btn:hover{color:var(--deep)}
.tab-btn.active{color:var(--deep);border-bottom-color:var(--deep);background:var(--lime-soft);font-weight:700}
.tab-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tab-badge{background:var(--lime-soft);color:var(--deep);border:1px solid rgba(124,179,66,.4);font-size:10px;padding:2px 7px;border-radius:10px;font-weight:700}

/* --- Main Canvas Container --- */
.canvas{flex:1;position:relative;overflow:hidden;display:flex;flex-direction:column;background:#fff}

/* --- Tab Panels --- */
.tab-panel{display:none;width:100%;height:100%;overflow:auto}
.tab-panel.active{display:flex}

/* --- TAB 1: Architecture View --- */
.arch-container{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:14px 28px;background:#fff}
.arch-container svg{max-width:100%;max-height:100%;width:auto;height:auto}

/* --- TAB 2: Visual Pipeline & AI Simulation --- */
.sim-container{display:grid;grid-template-columns:1.15fr 0.85fr;gap:20px;width:100%;height:100%;padding:18px 28px;overflow:hidden;background:#fff}
@media (max-width:1120px){.sim-container{grid-template-columns:1fr;overflow:auto}}

.flow-explorer{background:#fff;border:1px solid var(--card-border);border-radius:14px;padding:18px;display:flex;flex-direction:column;overflow:hidden;box-shadow:var(--shadow)}
.flow-explorer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-shrink:0}
.flow-explorer-head h2{font-size:15px;font-weight:700;color:var(--deep)}
.flow-selector-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px;flex-shrink:0;scrollbar-width:thin}
.flow-pill{background:#F8FAF7;border:1px solid var(--rule);color:var(--ink);border-radius:20px;padding:6px 14px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;transition:all .2s}
.flow-pill:hover{background:var(--lime-soft);border-color:var(--lime)}
.flow-pill.active{background:var(--deep);border-color:var(--deep);color:#fff}

.pipeline-systems-strip{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:8px 12px;background:#FAFBF9;border:1px solid var(--rule);border-radius:10px;flex-shrink:0;overflow-x:auto}
.pipeline-sys-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--deep);background:#fff;border:1px solid var(--rule);padding:4px 10px;border-radius:6px;white-space:nowrap}

.pipeline-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;flex-shrink:0}
@media (max-width:768px){.pipeline-grid{grid-template-columns:1fr}}
.pipeline-stage{background:#FAFBF9;border:1.5px solid var(--rule);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:5px;transition:all .3s;position:relative}
.pipeline-stage.active{background:var(--lime-soft);border-color:var(--deep);box-shadow:0 0 12px rgba(27,94,32,.2);transform:translateY(-2px)}
.stage-head{display:flex;align-items:center;gap:6px}
.stage-num{width:20px;height:20px;border-radius:50%;background:#E8ECE6;font-size:10.5px;font-weight:700;display:grid;place-items:center;color:var(--mute)}
.pipeline-stage.active .stage-num{background:var(--deep);color:#fff}
.stage-title{font-size:12px;font-weight:700;color:var(--ink)}
.stage-desc{font-size:10px;color:var(--mute);line-height:1.3}
.stage-live-badge{font-size:9.5px;font-family:'IBM Plex Mono',monospace;padding:2px 5px;border-radius:4px;background:#E8ECE6;color:var(--mute);margin-top:auto;font-weight:600}
.pipeline-stage.active .stage-live-badge{background:var(--deep);color:#fff}

.flow-map-body{flex:1;overflow-y:auto;padding-right:4px;display:flex;flex-direction:column;gap:8px}
.step-card{background:#FAFBF9;border:1px solid var(--rule);border-radius:8px;padding:9px 12px;display:grid;grid-template-columns:26px 1fr auto;gap:10px;align-items:center;transition:all .3s}
.step-card.active{background:var(--lime-soft);border-color:var(--deep);box-shadow:0 0 10px rgba(27,94,32,.15);transform:translateX(4px)}
.step-card.escalate-active{background:#FEF3C7;border-color:var(--amber);box-shadow:0 0 10px rgba(245,158,11,.2);transform:translateX(4px)}
.step-num{width:24px;height:24px;border-radius:50%;background:#E8ECE6;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--mute)}
.step-card.active .step-num{background:var(--deep);color:#fff}
.step-card.escalate-active .step-num{background:var(--amber);color:#fff}
.step-info h4{font-size:12px;font-weight:700;color:var(--ink)}
.step-info p{font-size:10.5px;color:var(--mute);margin-top:1px;line-height:1.35}
.step-system-tag{font-size:9.5px;padding:2px 6px;border-radius:5px;background:#E8ECE6;color:var(--mute);font-weight:600}

/* Right Phone Panel & Call Status Panel */
.phone-panel{background:#fff;border:1px solid var(--card-border);border-radius:14px;padding:18px;display:flex;flex-direction:column;overflow:hidden;box-shadow:var(--shadow)}
.phone-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule);padding-bottom:10px;flex-shrink:0}
.phone-status{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:var(--ink)}
.phone-dot{width:8px;height:8px;border-radius:50%;background:#9CA3AF}
.phone-dot.live{background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.5s infinite}
.phone-timer{font-size:12px;color:var(--mute);font-family:'IBM Plex Mono',monospace}

.lang-toggle-wrap{display:flex;align-items:center;gap:4px;background:#F8FAF7;border:1px solid var(--rule);padding:2px 4px;border-radius:8px}
.lang-btn{background:transparent;border:none;font:inherit;font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px;cursor:pointer;color:var(--mute);transition:all .2s}
.lang-btn.active{background:var(--deep);color:#fff}

.call-control-panel{background:#0D1B0F;color:#fff;border-radius:10px;padding:10px 12px;margin-top:10px;display:flex;flex-direction:column;gap:6px;flex-shrink:0;box-shadow:0 4px 12px rgba(13,27,15,.2)}
.ccp-head{display:flex;justify-content:space-between;align-items:center;font-size:10.5px;border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:5px}
.ccp-head-title{font-weight:700;color:#C6E2CB;display:flex;align-items:center;gap:6px}
.ccp-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:10.5px}
.ccp-item{display:flex;flex-direction:column;line-height:1.2}
.ccp-label{color:#A5D6A7;font-size:9px;text-transform:uppercase;letter-spacing:.4px}
.ccp-val{font-weight:700;color:#fff;margin-top:2px;font-family:'IBM Plex Mono',monospace}
.ccp-checks{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px;border-top:1px solid rgba(255,255,255,.12);padding-top:5px}
.ccp-check{font-size:9.5px;padding:2px 7px;border-radius:4px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);display:inline-flex;align-items:center;gap:4px;transition:all .3s}
.ccp-check.active{background:rgba(124,179,66,.25);color:#7CB342;border:1px solid #7CB342;font-weight:700}

.transcript-area{flex:1;overflow-y:auto;padding:12px 2px;display:flex;flex-direction:column;gap:10px}
.bubble{max-width:88%;padding:8px 12px;border-radius:12px;font-size:12px;line-height:1.5}
.bubble.caller{align-self:flex-end;background:#F1F3F0;color:var(--ink);border:1px solid #E5EBE3;border-bottom-right-radius:2px}
.bubble.ai{align-self:flex-start;background:var(--deep);color:#fff;border:1px solid var(--deep-dk);border-bottom-left-radius:2px}
.bubble-speaker{font-size:9px;font-weight:700;color:var(--mute);margin-bottom:2px;text-transform:uppercase;letter-spacing:.4px}
.bubble.ai .bubble-speaker{color:#A5D6A7}

.bubble.human-agent{align-self:flex-start;background:#FEF3C7;color:#78350F;border:1.5px solid #F59E0B;border-bottom-left-radius:2px}
.bubble.human-agent .bubble-speaker{color:#B45309;font-weight:700}
.handover-banner{align-self:stretch;background:#FFFBEB;border:1.5px dashed #F59E0B;border-radius:8px;padding:8px 12px;display:flex;flex-direction:column;gap:2px}
.hb-title{font-size:11px;font-weight:700;color:#B45309;display:flex;align-items:center;gap:6px}
.hb-desc{font-size:9.5px;color:#92400E;font-family:'IBM Plex Mono',monospace}

.action-card{align-self:stretch;background:#F0FDF4;border:1px solid #86EFAC;border-radius:8px;padding:7px 10px;display:flex;align-items:center;gap:8px}
.action-card.crm{border-color:#93C5FD;background:#EFF6FF}
.action-card.wa{border-color:#86EFAC;background:#F0FDF4}
.action-card.escalate{border-color:#FCD34D;background:#FFFBEB}
.action-icon{width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,.05);display:grid;place-items:center;flex-shrink:0}
.action-text{font-family:'IBM Plex Mono',monospace;font-size:10px;color:#14532D;line-height:1.4}
.action-card.crm .action-text{color:#1E3A8A}
.action-card.wa .action-text{color:#14532D}
.action-card.escalate .action-text{color:#78350F}

.sim-controls{border-top:1px solid var(--rule);padding-top:10px;display:flex;gap:10px;align-items:center;flex-shrink:0}
.btn-sim-play{flex:1;background:var(--deep);border:1px solid var(--deep);color:#fff;font:inherit;font-size:12.5px;font-weight:700;padding:8px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-sim-play:hover{background:var(--deep-dk)}
.btn-sim-play:disabled{opacity:.4;cursor:not-allowed}
.btn-sim-reset{background:#F8FAF7;border:1px solid var(--rule);color:var(--mute);font:inherit;font-size:12px;font-weight:600;padding:8px 12px;border-radius:8px;cursor:pointer}

/* --- TAB 3: OPERATIONS DASHBOARD (DUAL VIEW & DRILL-DOWNS) --- */
.dash-container{width:100%;height:100%;padding:18px 28px;overflow-y:auto;display:flex;flex-direction:column;gap:16px;background:#fff}

.dash-advisory-banner{background:#F0FDF4;border:1.5px solid #86EFAC;border-radius:12px;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.dab-left{display:flex;align-items:center;gap:14px}
.dab-logo-box{background:#111827;padding:4px 10px;border-radius:6px;display:flex;align-items:center}
.dab-logo-box img{height:22px;width:auto;mix-blend-mode:screen;object-fit:contain}
.dab-icon{width:32px;height:32px;border-radius:50%;background:var(--deep);color:#fff;display:grid;place-items:center;font-weight:700;flex-shrink:0}
.dab-text h4{font-size:13px;font-weight:700;color:var(--deep)}
.dab-text p{font-size:11px;color:var(--ink);margin-top:2px;max-width:750px;line-height:1.4}
.dash-view-toggle{display:inline-flex;gap:3px;background:#E8ECE6;border-radius:8px;padding:3px;flex-shrink:0}
.dvt-btn{border:none;background:transparent;padding:6px 14px;border-radius:6px;font:inherit;font-size:11.5px;font-weight:600;color:var(--mute);cursor:pointer;transition:all .2s}
.dvt-btn.active{background:#fff;color:var(--deep);font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.1)}

.proto-role-bar{background:#FAFBF9;border:1px solid var(--card-border);border-radius:10px;padding:8px 16px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.prb-left{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--mute)}
.prb-left strong{color:var(--ink)}
.role-pills{display:flex;align-items:center;gap:4px;background:#E8ECE6;border-radius:7px;padding:2px}
.role-btn{border:none;background:transparent;padding:4px 12px;border-radius:5px;font:inherit;font-size:11px;font-weight:600;color:var(--mute);cursor:pointer}
.role-btn.active{background:var(--deep);color:#fff}
.time-pills{display:flex;align-items:center;gap:4px}
.time-btn{border:1px solid var(--rule);background:#fff;padding:4px 10px;border-radius:6px;font:inherit;font-size:11px;font-weight:600;color:var(--mute);cursor:pointer}
.time-btn.active{background:var(--lime-soft);border-color:var(--lime);color:var(--deep)}

.view-typical{display:flex;flex-direction:column;gap:16px}
.view-custom-7{display:none;flex-direction:column;gap:18px}

.dash-kpis-video{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.dkv-card{background:#fff;border:1px solid var(--card-border);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow)}
.dkv-label{font-size:11.5px;color:var(--mute);font-weight:600}
.dkv-val{font-size:26px;font-weight:700;color:var(--deep);margin-top:2px;font-family:'IBM Plex Mono',monospace}
.dkv-delta{font-size:11px;color:var(--mute);margin-top:2px}
.dkv-delta.up{color:#15803D;font-weight:600}

.traffic-switcher{display:inline-flex;gap:3px;background:#E8ECE6;border-radius:7px;padding:2px;margin-left:10px}
.ts-btn{border:none;background:transparent;padding:4px 10px;border-radius:5px;font:inherit;font-size:10.5px;font-weight:600;color:var(--mute);cursor:pointer}
.ts-btn.active{background:#fff;color:var(--deep);font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,.08)}

/* Simple Executive Sentiment Overview Card */
.sentiment-overview-card{background:#FAFBF9;border:1px solid var(--card-border);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow)}
.sentiment-bars-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:10px}
.sent-progress-wrap{display:flex;flex-direction:column;gap:6px}
.sent-progress-bar{height:8px;background:#E2E8F0;border-radius:4px;overflow:hidden;display:flex}
.sent-segment-pos{background:#16A34A;height:100%}
.sent-segment-neu{background:#94A3B8;height:100%}
.sent-segment-neg{background:#F59E0B;height:100%}

.video-grid-21{display:grid;grid-template-columns:2fr 1fr;gap:16px}
@media (max-width:1080px){.video-grid-21{grid-template-columns:1fr}}

.vcard{background:#fff;border:1px solid var(--card-border);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow)}
.vcard-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.vcard-head h3{font-size:13.5px;font-weight:700;color:var(--ink)}
.vcard-head span{font-size:11px;color:var(--mute)}

.video-bars-wrap{display:flex;align-items:flex-end;gap:8px;height:140px;padding-top:10px}
.vbar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;height:100%;justify-content:flex-end;cursor:pointer}
.vbar{width:100%;max-width:26px;background:var(--deep);border-radius:4px 4px 1px 1px;min-height:6px;opacity:.85;transition:all .2s}
.vbar-col:hover .vbar{background:var(--lime);opacity:1;transform:scaleY(1.05)}
.vbar.active{background:var(--lime);opacity:1}
.vbar-label{font-size:10px;color:var(--mute);font-family:'IBM Plex Mono',monospace}

.hourly-drilldown-box{display:none;background:#FAFBF9;border:1px solid var(--rule);border-radius:10px;padding:12px 14px;margin-top:12px}
.hourly-drilldown-box.active{display:block}
.hourly-bars-row{display:flex;align-items:flex-end;gap:4px;height:65px;margin-top:8px}
.hbar-col{flex:1;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end}
.hbar{width:100%;background:var(--deep);border-radius:2px;min-height:3px}
.hbar-t{font-size:8px;color:var(--mute);margin-top:2px;font-family:'IBM Plex Mono',monospace}

.live-queue-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--rule)}
.live-queue-row:first-child{border-top:0;padding-top:0}
.lq-pulse{width:8px;height:8px;border-radius:50%;background:#16A34A;box-shadow:0 0 6px #86EFAC}

.tbl-agent{width:100%;border-collapse:collapse;font-size:12px}
.tbl-agent th{text-align:left;color:var(--mute);font-size:11px;padding:6px 8px;border-bottom:1px solid var(--rule);font-weight:600}
.tbl-agent td{padding:8px 8px;border-bottom:1px solid var(--rule)}
.tbl-agent tr.clickable{cursor:pointer;transition:background .2s}
.tbl-agent tr.clickable:hover{background:var(--lime-soft)}

.prog-bar-cell{height:6px;background:#E8ECE6;border-radius:3px;overflow:hidden;flex:1;margin-right:8px}
.prog-fill-cell{height:100%;background:var(--deep);border-radius:3px}

.qa-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--rule)}
.qa-row:first-child{border-top:0;padding-top:0}
.qa-icon{width:32px;height:32px;border-radius:8px;background:var(--lime-soft);color:var(--deep);display:grid;place-items:center;flex-shrink:0}
.qa-text{flex:1;min-width:0}
.qa-text strong{font-size:12px;color:var(--ink);display:block}
.qa-text span{font-size:10.5px;color:var(--mute)}
.btn-qa-open{background:#fff;border:1px solid var(--rule);padding:4px 10px;border-radius:6px;font:inherit;font-size:11px;font-weight:600;color:var(--deep);cursor:pointer}
.btn-qa-open:hover{background:var(--lime-soft);border-color:var(--lime)}

.sentiment-badge{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:4px;font-family:'IBM Plex Mono',monospace}
.sentiment-pos{background:#DCFCE7;color:#15803D}
.sentiment-neu{background:#F1F5F9;color:#475569}
.sentiment-esc{background:#FEF3C7;color:#B45309}

.custom-dash-tier{display:flex;flex-direction:column;gap:10px}
.custom-tier-title{font-size:12px;font-weight:800;color:var(--deep);text-transform:uppercase;letter-spacing:.5px;border-left:3px solid var(--lime);padding-left:8px}
.custom-tier-grid{display:grid;gap:14px}
.grid-3-col{grid-template-columns:repeat(3,1fr)}
.grid-2-col{grid-template-columns:repeat(2,1fr)}
@media (max-width:1120px){.grid-3-col,.grid-2-col{grid-template-columns:1fr}}

.chart-card{background:#fff;border:1px solid var(--card-border);border-radius:12px;padding:16px;display:flex;flex-direction:column;box-shadow:var(--shadow);cursor:pointer;transition:all .2s}
.chart-card:hover{border-color:var(--deep);transform:translateY(-2px);box-shadow:0 6px 16px rgba(27,94,32,.1)}
.chart-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:8px}
.chart-card-head h3{font-size:13.5px;font-weight:700;color:var(--ink)}
.chart-card-head .chart-tag{font-size:9.5px;color:var(--deep);background:var(--lime-soft);border:1px solid rgba(124,179,66,.4);padding:2px 7px;border-radius:4px;font-weight:700;white-space:nowrap}
.chart-card-desc{font-size:11px;color:var(--mute);margin-top:2px;line-height:1.35}
.chart-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--rule);padding-top:8px;margin-top:8px;font-size:10.5px;font-weight:700;color:var(--deep)}

/* --- TAB 4: AI INSIGHTS & QUALITY DASHBOARD --- */
.insights-container{width:100%;height:100%;padding:18px 28px;overflow-y:auto;display:flex;flex-direction:column;gap:18px;background:#fff}
.insights-top-row{display:grid;grid-template-columns:1.4fr 1fr;gap:18px}
@media (max-width:1080px){.insights-top-row{grid-template-columns:1fr}}

.topics-grid{display:grid;grid-template-columns:1.2fr 1fr;grid-template-rows:130px 90px;gap:10px;margin-top:10px}
.topic-tile{border-radius:10px;padding:12px 14px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s;cursor:pointer}
.topic-tile:hover{transform:translateY(-2px)}
.topic-tile.high-res{background:#046A5B}
.topic-tile.mid-res{background:#9A5B08}
.topic-tile.low-res{background:#8B1818}
.topic-name{font-size:13.5px;font-weight:700}
.topic-meta{font-size:11px;opacity:.9;font-family:'IBM Plex Mono',monospace}

.reasons-list{display:flex;flex-direction:column;gap:10px;margin-top:12px}
.reason-row{display:flex;flex-direction:column;gap:4px}
.reason-label-row{display:flex;justify-content:space-between;font-size:11.5px}
.reason-label-row strong{color:var(--ink)}
.reason-bar{height:7px;background:#E2E8F0;border-radius:4px;overflow:hidden}
.reason-fill{height:100%;background:#4F46E5;border-radius:4px}

.insights-mid-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media (max-width:1080px){.insights-mid-row{grid-template-columns:1fr}}

.quality-bars{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.quality-item{display:flex;align-items:center;gap:12px;font-size:12px}
.quality-item span{width:160px;color:var(--ink);font-weight:600}
.quality-bar{flex:1;height:8px;background:#E2E8F0;border-radius:4px;overflow:hidden}
.quality-fill{height:100%;background:#4F46E5;border-radius:4px}
.quality-val{width:28px;text-align:right;font-weight:700;font-family:'IBM Plex Mono',monospace}

.gaps-list{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.gap-item{display:flex;align-items:center;justify-content:space-between;background:#FAFBF9;border:1px solid var(--rule);padding:10px 14px;border-radius:8px;font-size:12px}
.gap-question{font-weight:700;color:var(--ink)}
.gap-asked{font-size:10px;color:var(--mute);margin-top:2px}
.btn-add-answer{background:#fff;border:1px solid var(--rule);color:var(--deep);font:inherit;font-size:11px;font-weight:700;padding:4px 10px;border-radius:6px;cursor:pointer}
.btn-add-answer:hover{background:var(--lime-soft);border-color:var(--lime)}

.heatmap-card{background:#fff;border:1px solid var(--card-border);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow)}
.heatmap-grid{display:grid;grid-template-columns:40px repeat(8,1fr);gap:4px;margin-top:12px;align-items:center}
.hm-day{font-size:11px;color:var(--mute);font-weight:600}
.hm-cell{height:22px;border-radius:4px;background:#EDE9FE}
.hm-cell.lvl-1{background:#DDD6FE}
.hm-cell.lvl-2{background:#C4B5FD}
.hm-cell.lvl-3{background:#A78BFA}
.hm-cell.lvl-4{background:#8B5CF6}
.hm-cell.lvl-5{background:#6D28D9}

/* Modals & Drawer */
.chart-drilldown-modal{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:110;display:none;align-items:center;justify-content:center;backdrop-filter:blur(3px)}
.chart-drilldown-modal.active{display:flex}
.cdm-content{background:#fff;border:1px solid var(--card-border);border-radius:14px;width:min(680px,94%);max-height:88vh;overflow-y:auto;padding:24px;box-shadow:0 20px 50px rgba(0,0,0,.25);display:flex;flex-direction:column;gap:16px}
.cdm-head{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule);padding-bottom:14px}

.goal-metric-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;align-items:center;padding:8px 0;flex:1}
.goal-big-num{font-size:34px;font-weight:800;color:var(--deep);font-family:'IBM Plex Mono',monospace;line-height:1.1}
.goal-num-sub{font-size:11.5px;font-weight:700;color:var(--ink);margin-top:4px}
.goal-pill-up{display:inline-flex;align-items:center;gap:4px;background:#DCFCE7;color:#15803D;font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:6px;margin-top:6px}
.goal-breakdown-list{display:flex;flex-direction:column;gap:8px;border-left:1px solid var(--rule);padding-left:14px}
.gbl-item{display:flex;flex-direction:column;gap:3px}
.gbl-row{display:flex;justify-content:space-between;font-size:11px;color:var(--mute)}
.gbl-row strong{color:var(--ink);font-family:'IBM Plex Mono',monospace}
.gbl-bar{height:5px;background:#E8ECE6;border-radius:3px;overflow:hidden}
.gbl-fill{height:100%;background:var(--deep);border-radius:3px}

.kb-cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.kb-cap-box{background:#F8FAF7;border:1px solid var(--rule);border-radius:8px;padding:10px 12px}
.kb-doc-list{display:flex;flex-direction:column;gap:8px;max-height:220px;overflow-y:auto;padding-right:4px}
.kb-doc-item{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#fff;border:1px solid var(--rule);border-radius:8px;font-size:11.5px}
.kb-form-box{background:#F8FAF7;border:1px solid var(--card-border);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:10px}
.kb-input{width:100%;padding:7px 10px;border:1px solid var(--card-border);border-radius:6px;font:inherit;font-size:12px}

.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:90;display:none;backdrop-filter:blur(2px)}
.drawer-overlay.active{display:block}
.drawer{position:fixed;top:0;bottom:0;right:0;width:min(520px,100%);background:#fff;border-left:1px solid var(--card-border);z-index:100;box-shadow:-10px 0 40px rgba(0,0,0,.2);display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s ease-out}
.drawer.active{transform:translateX(0)}
.drawer-head{padding:16px 20px;border-bottom:1px solid var(--rule);display:flex;align-items:flex-start;justify-content:space-between}
.drawer-head h2{font-size:15px;font-weight:700;color:var(--ink)}
.drawer-head p{font-size:11px;color:var(--mute);font-family:'IBM Plex Mono',monospace}
.drawer-body{flex:1;overflow-y:auto;padding:16px 20px;display:flex;flex-direction:column;gap:14px}
.drawer-close{background:transparent;border:none;color:var(--mute);font-size:22px;cursor:pointer}

.drawer-player{background:#F8FAF7;border:1px solid var(--rule);border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:12px}
.drawer-play-btn{width:32px;height:32px;border-radius:50%;background:var(--deep);color:#fff;display:grid;place-items:center;border:none;cursor:pointer;flex-shrink:0}
.drawer-wave{display:flex;align-items:center;gap:2px;height:24px;flex:1}
.drawer-wave span{flex:1;background:var(--deep);opacity:.25;border-radius:1px}
.drawer-wave span.played{opacity:1}

.bottom{background:#F8FAF7;border-top:1px solid #D7E1D4;padding:8px 28px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;font-size:11px;color:var(--mute)}
.bottom button{background:#fff;border:1px solid #D7E1D4;color:var(--ink);font:inherit;font-size:11px;padding:4px 12px;border-radius:6px;cursor:pointer;transition:all .2s}
.bottom button:hover{background:var(--lime-soft);border-color:var(--lime)}
</style>
</head>
<body>

<!-- Top Header with Exact SOE Logo & Lifetime Fitness Brand -->
<div class="top">
  <div class="brand-img-wrap" id="topSoeWrap">
    <!-- Pure Vector SOE Logo (Zero Font Dependencies - from SOE logo - White_3.png) -->
