    <div class="client-text">
      <div class="client-name" id="clientName">Lifetime Fitness</div>
      <div class="client-date" id="clientDate">2 November 2026</div>
    </div>
  </div>
</div>

<!-- Navigation Tab Bar (Strictly 3 Focused Tabs) -->
<div class="tab-bar">
  <button class="tab-btn active" data-tab="tabArch" id="tabBtnArch">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
    Architecture Diagram
  </button>
  <button class="tab-btn" data-tab="tabSim" id="tabBtnSim">
    <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
    Automation Flow &amp; Live Call
    <span class="tab-badge" id="badgeFlowsCount">10 Flows Active</span>
  </button>
  <button class="tab-btn" data-tab="tabDash" id="tabBtnDash">
    <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    Operations Dashboard
  </button>
</div>

<!-- Main Canvas -->
<div class="canvas">
  <div class="waiting" id="waitMsg" style="display:none"></div>

  <!-- TAB 1: Architecture -->
  <div class="tab-panel active" id="tabArch">
    <div class="arch-container" id="archWrap"></div>
  </div>

  <!-- TAB 2: Visual Pipeline & Live Call Simulation -->
  <div class="tab-panel" id="tabSim">
    <div class="sim-container">
      <div class="flow-explorer">
        <div class="flow-explorer-head">
          <div>
            <h2>Automation Pipeline: End-to-End Execution</h2>
            <div style="font-size:11px;color:var(--mute)">How customer gym equipment, playground, sauna &amp; pool inquiries flow into CRM</div>
          </div>
        </div>

        <div class="pipeline-systems-strip" id="pipelineSysStrip"></div>

        <div class="pipeline-grid">
          <div class="pipeline-stage" id="stage_1">
            <div class="stage-head">
              <span class="stage-num">1</span>
              <span class="stage-title">Conversation</span>
            </div>
            <div class="stage-desc">Natural Saudi Arabic / English speech recognition</div>
            <div class="stage-live-badge" id="badge_stage_1">Audio stream active</div>
          </div>
          <div class="pipeline-stage" id="stage_2">
            <div class="stage-head">
              <span class="stage-num">2</span>
              <span class="stage-title">Data Structuring</span>
            </div>
            <div class="stage-desc">Extracts equipment specs, facility size &amp; project scope</div>
            <div class="stage-live-badge" id="badge_stage_2">Entities extracted</div>
          </div>
          <div class="pipeline-stage" id="stage_3">
            <div class="stage-head">
              <span class="stage-num">3</span>
              <span class="stage-title">Decision Engine</span>
            </div>
            <div class="stage-desc">Checks showroom schedule &amp; warranty rules</div>
            <div class="stage-live-badge" id="badge_stage_3">Rules verified</div>
          </div>
          <div class="pipeline-stage" id="stage_4">
            <div class="stage-head">
              <span class="stage-num">4</span>
              <span class="stage-title">System Update</span>
            </div>
            <div class="stage-desc">Syncs CRM pipeline &amp; dispatches WhatsApp catalog</div>
            <div class="stage-live-badge" id="badge_stage_4">Transaction logged</div>
          </div>
        </div>

        <div class="flow-selector-row" id="flowPillList"></div>
        <div class="flow-map-body" id="flowStepsList"></div>
      </div>

      <div class="phone-panel">
        <div class="phone-top">
          <div class="phone-status">
            <span class="phone-dot" id="simDot"></span>
            <span id="simStatusText">Ready to simulate</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <div class="lang-toggle-wrap">
              <button class="lang-btn active" id="btnLangEn">English</button>
              <button class="lang-btn" id="btnLangAr">العربية</button>
            </div>
            <div class="phone-timer" id="simTimer">00:00</div>
          </div>
        </div>

        <!-- Live Call Control Panel (Clean Business Wording) -->
        <div class="call-control-panel" id="callControlPanel">
          <div class="ccp-head">
            <span class="ccp-head-title">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              LIVE CALL CONTROL PANEL &amp; CRM TRACKER
            </span>
            <span style="font-size:9.5px;color:#A5D6A7;font-family:'IBM Plex Mono',monospace">SOE Enterprise Engine</span>
          </div>
          <div class="ccp-grid">
            <div class="ccp-item">
              <span class="ccp-label">Inquiry Purpose</span>
              <span class="ccp-val" id="ccpPurpose">Showroom Consultation</span>
            </div>
            <div class="ccp-item">
              <span class="ccp-label">Connected System</span>
              <span class="ccp-val" id="ccpSys">700Apps CRM Pipeline</span>
            </div>
            <div class="ccp-item">
              <span class="ccp-label">Dialect / Language</span>
              <span class="ccp-val" id="ccpDialect">English (Commercial)</span>
            </div>
            <div class="ccp-item">
              <span class="ccp-label">Call Outcome</span>
              <span class="ccp-val" id="ccpOutcome" style="color:#7CB342">Ready to Simulate</span>
            </div>
          </div>
          <div class="ccp-checks">
            <span class="ccp-check" id="chk_verified">&#9711; Client Verified</span>
            <span class="ccp-check" id="chk_queried">&#9711; System Queried</span>
            <span class="ccp-check" id="chk_logged">&#9711; Logged in CRM</span>
            <span class="ccp-check" id="chk_followup">&#9711; WhatsApp Dispatched</span>
          </div>
        </div>

        <div class="transcript-area" id="simTranscript">
          <div style="text-align:center;color:var(--mute);margin:auto;font-size:12px">
            Click "Start Simulated Call" below to test the AI Voice Agent on this gym equipment flow.
          </div>
        </div>

        <div class="sim-controls">
          <button class="btn-sim-play" id="btnPlaySim">&#9654; Start Simulated Call</button>
          <button class="btn-sim-reset" id="btnResetSim" title="Reset transcript">&#8635;</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 3: Operations Dashboard -->
  <div class="tab-panel" id="tabDash">
    <div class="dash-container">
      <div class="dash-advisory-banner">
        <div class="dab-left">
          <div class="dab-icon">i</div>
          <div class="dab-text">
            <h4>Default AI Contact Center Admin View</h4>
            <p>This layout reflects our default enterprise contact center admin view. Your scope includes full dashboard customization with up to 7 custom KPI charts configured to Lifetime Fitness's exact commercial equipment workflows and feedback post-onboarding.</p>
          </div>
        </div>
        <div class="dash-view-toggle">
          <button class="dvt-btn active" id="btnViewTypical">Default AI Contact Center Admin View</button>
          <button class="dvt-btn" id="btnViewCustom7">Customized Dashboard (Up to 7 Charts)</button>
        </div>
      </div>

      <!-- VIEW 1: Typical Enterprise Contact Center View (Dedicated Admin View) -->
      <div class="view-typical" id="wrapTypicalView">
        <div class="proto-role-bar">
          <div class="prb-left">
            <span class="admin-badge">Admin View</span>
