function renderVideoBars(){
  var wrap = document.getElementById("videoBarsWrap");
  if(!wrap) return;
  wrap.innerHTML = "";

  var dayValues = [42, 51, 48, 62, 58, 30, 22, 65, 72, 70, 78, 59, 28, 55];
