  if(fcode === "OUT-1" || fid === "remind") return "700Apps Booking Module (Built-in)";
  if(fcode.indexOf("OUT") === 0) return "700Apps CRM Pipeline (Built-in)";
  return "700Apps CRM & Booking System";
