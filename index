function openCallInspector(idx){
  var calls = window.dashSampleCalls || [];
  var call = calls[idx];
  if(!call) return;

  document.getElementById("drawerTitle").textContent = call.flow;
  document.getElementById("drawerCallId").textContent = call.id + " · Voice AI Call";
  document.getElementById("drawerOutcome").textContent = call.out;
  document.getElementById("drawerOutcome").style.color = call.ok ? "var(--deep)" : "var(--amber)";
  document.getElementById("drawerSync").textContent = "700Apps CRM Pipeline (Native)";

  // Clean, Simple Sentiment
  var sBadge = document.getElementById("drwSentimentBadge");
  sBadge.textContent = call.sent + " (Satisfied)";
  sBadge.className = "sentiment-badge " + (call.sent === "Positive" ? "sentiment-pos" : call.sent === "Neutral" ? "sentiment-neu" : "sentiment-esc");
  document.getElementById("drwStartMood").textContent = call.scStart || "Inquiring / Calm";
  document.getElementById("drwMidMood").textContent = call.scMid || "Reassured";
  document.getElementById("drwEndMood").textContent = call.scEnd || "High Satisfaction";
  document.getElementById("drwIntent").textContent = call.emo || "Facility Fit-Out";
  document.getElementById("drwPhrases").textContent = call.phrases || "\"Commercial Equipment\", \"Showroom\"";

  var wf = document.getElementById("drawerWave");
  wf.innerHTML = "";
  for(var w=0; w<45; w++){
    var barH = 15 + Math.round(Math.abs(Math.sin(w * 0.6) * 55 + Math.sin(w * 1.8) * 25));
    var sp = document.createElement("span");
    sp.style.height = Math.min(100, barH) + "%";
    if(w < 16) sp.className = "played";
    wf.appendChild(sp);
  }

  var txContainer = document.getElementById("drawerTranscript");
  txContainer.innerHTML = "";

  var flows = getCombinedFlows(currentData);
  var targetFlow = flows[0];
  if(call.isEscalate){
    targetFlow = flows.find(function(f){ return f.id==="resched" || f.id==="complaint" || f.id==="urgent"; }) || { id:"resched", label:"Reschedule consultation" };
