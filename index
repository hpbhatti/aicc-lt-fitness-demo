function renderFlowTabs(){
  if(!currentData) return;
  var flows = getCombinedFlows(currentData);
  var pillList = document.getElementById("flowPillList");
  var badge = document.getElementById("badgeFlowsCount");
  if(badge) badge.textContent = flows.length + " Flows Active";

  if(pillList){
    pillList.innerHTML = "";
    flows.forEach(function(f, idx){
      var pill = document.createElement("button");
      pill.className = "flow-pill" + (idx === activeFlowIndex ? " active" : "");
      var isEsc = f.id==="resched" || f.id==="complaint" || f.id==="urgent";
      var extraLabel = isEsc ? " (Human Handover Demo)" : "";
      pill.innerHTML = (f.direction==="inbound"?"&#8601; ":"&#8599; ") + esc(f.code ? f.code+": "+f.label+extraLabel : f.label+extraLabel);
      pill.addEventListener("click", function(){
        activeFlowIndex = idx;
        renderFlowTabs();
        resetSimulation();
      });
      pillList.appendChild(pill);
    });
  }

  renderPipelineSystemsStrip(currentData);

  var cur = flows[activeFlowIndex];
  renderActiveFlowSteps(cur);
  updateCallHud(cur, currentData, simLanguage);
}

function resetSimulation(){
  simRunning = false;
  var dot = document.getElementById("simDot");
  if(dot) dot.className = "phone-dot";
  var stText = document.getElementById("simStatusText");
  if(stText) stText.textContent = "Ready to simulate";
  var timer = document.getElementById("simTimer");
  if(timer) timer.textContent = "00:00";
  var btnPlay = document.getElementById("btnPlaySim");
  if(btnPlay){
    btnPlay.disabled = false;
    btnPlay.innerHTML = "&#9654; Start Simulated Call";
  }

  for(var st=1; st<=4; st++){
    var stageEl = document.getElementById("stage_" + st);
    if(stageEl) stageEl.classList.remove("active");
  }

  document.querySelectorAll(".step-card").forEach(function(c){
    c.classList.remove("active");
    c.classList.remove("escalate-active");
  });

  document.querySelectorAll(".ccp-check").forEach(function(c){
    c.className = "ccp-check";
  });
  var outcome = document.getElementById("ccpOutcome");
  if(outcome){
    outcome.textContent = "Ready to Simulate";
    outcome.style.color = "var(--lime)";
  }

  var tx = document.getElementById("simTranscript");
  if(tx){
    tx.innerHTML = '<div style="text-align:center;color:var(--mute);margin:auto;font-size:12px">Click "Start Simulated Call" below to test the AI Voice Agent on this gym equipment flow.</div>';
  }
}

function runSimulatedCall(){
  if(simRunning) return;
  var flows = getCombinedFlows(currentData);
  if(!flows.length) return;
  if(activeFlowIndex < 0) activeFlowIndex = 0;
  var flow = flows[activeFlowIndex];
  var script = buildSimulationScript(flow, currentData, simLanguage);

  simRunning = true;
  var btnPlay = document.getElementById("btnPlaySim");
  if(btnPlay){
    btnPlay.disabled = true;
    btnPlay.innerHTML = "&#10074;&#10074; Simulating...";
  }
  var dot = document.getElementById("simDot");
  if(dot) dot.className = "phone-dot live";
  var stText = document.getElementById("simStatusText");
  if(stText) stText.textContent = "Call in progress";
  var outcome = document.getElementById("ccpOutcome");
  if(outcome){
    outcome.textContent = "In Progress";
    outcome.style.color = "#F59E0B";
  }

  var transcript = document.getElementById("simTranscript");
  if(transcript) transcript.innerHTML = "";

  var startTime = Date.now();
  var timerInterval = setInterval(function(){
    if(!simRunning){ clearInterval(timerInterval); return; }
    var sec = Math.floor((Date.now() - startTime) / 1000);
    var m = String(Math.floor(sec/60)).padStart(2,'0');
    var s = String(sec%60).padStart(2,'0');
    var timer = document.getElementById("simTimer");
    if(timer) timer.textContent = m + ":" + s;
  }, 1000);

  setTimeout(function(){
    var chk = document.getElementById("chk_verified");
    if(chk) chk.className = "ccp-check active";
  }, 1200);

  var lineIdx = 0;
  function nextLine(){
    if(lineIdx >= script.length){
      simRunning = false;
      var d = document.getElementById("simDot");
      if(d) d.className = "phone-dot";
      var st = document.getElementById("simStatusText");
      if(st) st.textContent = "Call completed";
      var bp = document.getElementById("btnPlaySim");
      if(bp){
        bp.disabled = false;
        bp.innerHTML = "&#8635; Replay Call";
      }
      var oc = document.getElementById("ccpOutcome");
      if(oc){
        oc.textContent = "Completed & Synced";
        oc.style.color = "#7CB342";
      }
      return;
    }

    var item = script[lineIdx];

    if(item.stage){
      for(var st=1; st<=4; st++){
        var stageEl = document.getElementById("stage_" + st);
        if(stageEl){
          if(st <= item.stage) stageEl.classList.add("active");
          else stageEl.classList.remove("active");
        }
      }
    }

    if(item.chk){
      var chkEl = document.getElementById(item.chk);
      if(chkEl) chkEl.className = "ccp-check active";
    }

    if(!transcript) return;

    if(item.type === "action"){
      var act = document.createElement("div");
      act.className = "action-card " + (item.cat || "api");
      var iconSvg = svgIcon(item.icon||"layers", 0, 0, 14, item.cat==="escalate"?"#F59E0B":item.cat==="wa"?"#16A34A":"#1B5E20", 2);
      act.innerHTML = '<div class="action-icon">'+iconSvg+'</div><div class="action-text">'+esc(item.text)+'</div>';
      transcript.appendChild(act);
    } else if(item.type === "handover"){
      var hb = document.createElement("div");
      hb.className = "handover-banner";
      hb.innerHTML = '<div class="hb-title"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>'+esc(item.title)+'</div><div class="hb-desc">'+esc(item.desc)+'</div>';
      transcript.appendChild(hb);

      var oc = document.getElementById("ccpOutcome");
      if(oc){
        oc.textContent = "Warm Handover (Tariq - Ext 101)";
        oc.style.color = "#F59E0B";
      }

      document.querySelectorAll(".step-card").forEach(function(sc){
        if(sc.textContent.indexOf("Escalation") >= 0 || sc.textContent.indexOf("Handover") >= 0 || sc.textContent.indexOf("تحويل") >= 0){
          sc.classList.add("escalate-active");
        }
      });
    } else {
      var b = document.createElement("div");
      b.className = "bubble " + item.speaker;
      var spkLabel = item.speaker==="ai" ? "AI Voice Agent" : (item.speaker==="human-agent" ? (item.speakerName || "Sales Representative (Tariq — Ext. 101)") : "Client (Faisal)");
      b.innerHTML = '<div class="bubble-speaker">'+esc(spkLabel)+'</div>'+esc(item.text);
      transcript.appendChild(b);
    }

    transcript.scrollTop = transcript.scrollHeight;

    lineIdx++;
    var delay = item.type === "action" ? 1700 : (item.speaker === "ai" ? 2200 : 1600);
    setTimeout(nextLine, delay);
  }

  nextLine();
}

/* ========== HEATMAP GENERATOR (TAB 4) ========== */
function renderHeatmap(){
  var grid = document.getElementById("heatmapGrid");
  if(!grid || grid.children.length > 0) return;
  var days = ["Sun", "Mon", "Tue", "Wed", "Thu"];
  var hours = ["0h", "3h", "6h", "9h", "12h", "15h", "18h", "21h"];
  
  // Header row
  var headerHtml = '<div></div>';
  hours.forEach(function(h){ headerHtml += '<div style="font-size:10px;color:var(--mute);text-align:center">'+h+'</div>'; });
  grid.innerHTML = headerHtml;

  var density = [
    [0, 0, 0, 3, 5, 4, 4, 1], // Sun
    [0, 0, 0, 4, 5, 5, 4, 2], // Mon
    [0, 0, 0, 3, 5, 5, 3, 1], // Tue
    [0, 0, 0, 4, 4, 4, 3, 1], // Wed
    [0, 0, 0, 3, 4, 3, 2, 0]  // Thu
  ];

  days.forEach(function(d, di){
    var rowHtml = '<div class="hm-day">'+d+'</div>';
    density[di].forEach(function(val){
      var lvlClass = val === 0 ? '' : ' lvl-' + val;
      rowHtml += '<div class="hm-cell'+lvlClass+'" title="'+d+' commercial traffic index: '+val+'/5"></div>';
    });
    grid.innerHTML += rowHtml;
  });
}

