    col.className = "vbar-col";
    var pct = Math.round((val / max) * 100);
    var isPeak = val === max;
    col.innerHTML = '<div class="vbar'+(isPeak?" active":"")+'" style="height:'+pct+'%"></div><span class="vbar-label">'+(idx+1)+'</span>';
    col.title = "Day " + (idx+1) + ": " + val + " calls";
