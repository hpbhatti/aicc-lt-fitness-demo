      document.querySelectorAll(".vbar").forEach(function(b){ b.classList.remove("active"); });
      col.querySelector(".vbar").classList.add("active");
      document.getElementById("drilldownDayHint").innerHTML = '<strong style="color:var(--deep)">Day '+(idx+1)+' Drill-Down:</strong> '+val+' calls · Peak at 11:30 AM · 100% answered · 0 missed';
      showHourlyDrilldown(idx + 1, val);
